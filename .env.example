# Payam-e-Adab — environment variables (template)
# Copy to .env for local development, or set these in Vercel
# (Project → Settings → Environment Variables). NEVER commit real secrets.

# ── Database (required) ─────────────────────────────────────────────
# Turso/libSQL remote database — the app talks to it through the Prisma
# libSQL driver adapter. Create a database at https://turso.tech and a
# token with `turso db tokens create <name>`.
TURSO_DATABASE_URL=libsql://your-db-name-your-username.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Local SQLite fallback (used only when TURSO_DATABASE_URL is unset,
# and by the Prisma CLI). File path relative to prisma/schema.prisma.
DATABASE_URL="file:../db/custom.db"

# ── Session signing (recommended in production) ─────────────────────
# Signs the session cookie tokens. Falls back to a built-in key when
# unset — always set a strong random value on real deployments:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-string

# ── File uploads (optional) ─────────────────────────────────────────
# On Vercel the filesystem is read-only; connect a Blob store in the
# Vercel dashboard (Project → Storage → Create Blob) and this variable
# is set automatically. Without it, uploads return a clear error.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ── Email (no env vars needed) ──────────────────────────────────────
# SMTP credentials are configured inside the app: Admin Panel → Settings.
